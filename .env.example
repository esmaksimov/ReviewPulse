# ---- Telegram ---------------------------------------------------------------
# From @BotFather. The bot must be an administrator in the channel AND a member
# (ideally admin) of its linked discussion group.
BOT_TOKEN=123456:AA...

# Optional: numeric ids allowed to use admin commands.
ADMIN_USER_IDS=

# ---- Working hours ----------------------------------------------------------
# Reminders are sent only inside this window, and SLAs consume working time only.
TIMEZONE_OFFSET_HOURS=3
WORK_START=09:00
WORK_END=18:00
# 0 = Monday ... 6 = Sunday
WORK_DAYS=0,1,2,3,4

# ---- Escalation -------------------------------------------------------------
# Working minutes of silence before the first reminder.
SLA_MINUTES=120
# Same, but for "the fixes are in and ✍️ still stands".
RECHECK_SLA_MINUTES=120
NUDGE_INTERVAL_MINUTES=20
MAX_NUDGES_PER_DAY=8
# Ceiling on how many 👍 close a review. The actual requirement scales down to the
# number of reviewers named in the post: name one, one approval closes it; name two,
# both must sign off. This only kicks in once you name more reviewers than the cap.
REQUIRED_APPROVALS=2

# ---- GitLab (optional) ------------------------------------------------------
# Off until you issue a token. With it on, the bot detects "all my threads are
# resolved" by itself instead of waiting for someone to press "✅ Fixed".
# Token needs read_api on the reviewed projects.
GITLAB_ENABLED=false
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_TOKEN=
GITLAB_POLL_MINUTES=5

# ---- Language -----------------------------------------------------------------
# Locale for the shared tracker card and the registration hint (they have no single
# owner, so they can't follow one person's language). One of: ru, en, es, it, zh.
# DMs use each reviewer's own language instead — from Telegram's client language, or
# /lang if they set one explicitly — so this does not need to match everyone.
DEFAULT_LOCALE=en

# ---- Storage ----------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/reviewpulse.db
LOG_LEVEL=INFO
