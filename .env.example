# ---- Telegram ---------------------------------------------------------------
# From @BotFather. The bot must be an administrator in the channel AND a member
# (ideally admin) of its linked discussion group.
BOT_TOKEN=123456:AA...

# Optional: numeric ids allowed to use admin commands.
ADMIN_USER_IDS=

# ---- Working hours ----------------------------------------------------------
# Reminders are sent only inside this window, and SLAs consume working time only.
TIMEZONE_OFFSET_HOURS=3
WORK_START=09:00
WORK_END=18:00
# 0 = Monday ... 6 = Sunday
WORK_DAYS=0,1,2,3,4

# ---- Escalation -------------------------------------------------------------
# Working minutes of silence before the first reminder.
SLA_MINUTES=120
# Same, but for "the fixes are in and ✍️ still stands".
RECHECK_SLA_MINUTES=120
NUDGE_INTERVAL_MINUTES=20
MAX_NUDGES_PER_DAY=8
# Ceiling on how many 👍 close a review. The actual requirement scales down to the
# number of reviewers named in the post: name one, one approval closes it; name two,
# both must sign off. This only kicks in once you name more reviewers than the cap.
REQUIRED_APPROVALS=2

# ---- GitLab (optional) ------------------------------------------------------
# Off until you issue a token. With it on, the bot detects "all my threads are
# resolved" by itself instead of waiting for someone to press "✅ Fixed".
# Token needs read_api on the reviewed projects.
GITLAB_ENABLED=false
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_TOKEN=
GITLAB_POLL_MINUTES=5

# ---- Review announcements (optional) -----------------------------------------
# Lets people generate the announcement post with /announce in a DM to the bot
# instead of typing the template by hand: it fills in the product name and picks
# reviewers itself. JSON object keyed by GitLab project_path (the same slug from an
# MR URL, e.g. "group/subgroup/project"). Each entry: "product" (shown on the post),
# "techlead" (optional — a reviewer always included on that project, e.g. a senior
# dev who signs off on everything there), "pool" (candidates for the remaining
# random slot(s)), "reviewer_count" (total reviewers on the post, default 2).
# Real usernames belong ONLY in a real .env, never committed — the example below is
# a placeholder project with placeholder people.
REVIEW_PROJECTS={"example/demo-project":{"product":"Demo Product","techlead":"user1","pool":["user2","user3","user4"]}}

# ---- Stats report (optional) ---------------------------------------------------
# A periodic DM digest — average time authors take to address "needs changes" and
# average time reviewers take to give a first verdict, broken down per person.
# Nothing is sent unless at least one recipient id is set (see ADMIN_USER_IDS for
# how to find a numeric Telegram id — a recipient doesn't need to be a bot admin).
STATS_REPORT_RECIPIENT_IDS=
STATS_REPORT_INTERVAL_DAYS=7

# ---- Language -----------------------------------------------------------------
# Locale for the shared tracker card and the registration hint (they have no single
# owner, so they can't follow one person's language). One of: ru, en, es, it, zh.
# DMs use each reviewer's own language instead — from Telegram's client language, or
# /lang if they set one explicitly — so this does not need to match everyone.
DEFAULT_LOCALE=en

# ---- Storage ----------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/reviewpulse.db
LOG_LEVEL=INFO
